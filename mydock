#!/usr/bin/env bash
#
# mydock - Enhanced Docker container management script
# Phase 1: User Mirroring, Network Management, Interactive Shell
#

set -Eeuo pipefail
trap cleanup SIGINT SIGTERM ERR EXIT

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)

# Load library functions
if [[ -f "${script_dir}/lib/utils.sh" ]]; then
  source "${script_dir}/lib/utils.sh"
  source "${script_dir}/lib/mirror.sh"
  source "${script_dir}/lib/network.sh"
  source "${script_dir}/lib/interactive.sh"
  source "${script_dir}/lib/wizard.sh"
fi

PORTS=
ENV=
EXTRA_RUN_FLAGS=
VERBOSE=0

# Configuration directory
CONF_DIR="${script_dir}/conf"

# Load default config if exists
[[ -f "${CONF_DIR}/default.conf" ]] && . "${CONF_DIR}/default.conf"

cleanup() {
  trap - SIGINT SIGTERM ERR EXIT
  # script cleanup here
}

usage() {
  cat << EOF
Usage: $(basename "${BASH_SOURCE[0]}") <cmd> [<options>]

Available commands:

Container Management:
  build           Build image from --docker-file
  run             Create and start a new container
  start           Start an existing container
  stop            Stop a container
  rm              Remove container
  rm_image        Remove image
  shell           Enter container in a shell
  user            Enter container as User
  sync            Commit container (save it)
  logs            Show logs

Information:
  images          Show all images
  ps              Show all containers
  show            Run the images and ps command
  show_config     Show the config parameters

User Management:
  setup_users     Create users according to --users <file>
  setup_mirror    Setup mirrored user in existing container
  
Network Management:
  network         Network operations (create, list, inspect, remove, connect, disconnect)

Configuration:
  wizard          Interactive wizard to create config files
  quick           Quick setup wizard (minimal questions)

Interactive Mode:
  interactive     Enter interactive shell mode
  (no command)    Enter interactive mode (default)

Utility:
  help            This help

Available options:

-h, --help              Print this help and exit
-v, --verbose           Be Verbose (set -x)
-n, --name <name>       Name of container (override config file setting)
--tag <tag>             Tag name (override config file setting)
-u, --user <user>       User name (override env / config file setting)
-p, --ports <ports>     Ports to expose (override config file setting)
-e, --env <env>         Environment variables (override config file setting)
--config <file>         Load configuration file
--users <file>          Users file for setup_users command
--docker-file <file>    Dockerfile for build command
--network <name>        Network name (override config file setting)
--mirror-user           Enable user mirroring
--dry-run               Show docker command without executing
--xcmd <cmd>            Execute command in container

Examples:
  $(basename "${BASH_SOURCE[0]}")                    # Enter interactive mode
  $(basename "${BASH_SOURCE[0]}") interactive        # Enter interactive mode
  $(basename "${BASH_SOURCE[0]}") wizard             # Create new config file
  $(basename "${BASH_SOURCE[0]}") --config debian.conf run    # Run container with config
  $(basename "${BASH_SOURCE[0]}") --config debian.conf shell  # Enter container shell

EOF
  exit 0
}

config() {
  local conf_file="${config_file-default.conf}"
  
  # Handle both absolute paths and relative config names
  local conf_path=""
  if [[ "${conf_file}" == /* ]]; then
    # Absolute path
    conf_path="${conf_file}"
  elif [[ -f "${conf_file}" ]]; then
    # File in current directory (for backwards compatibility)
    conf_path="${conf_file}"
  else
    # Look in conf directory
    conf_path="${CONF_DIR}/${conf_file}"
  fi
  
  if [[ -f "${conf_path}" ]]; then
    # Source the config file, but don't exit if it has issues
    set +e
    . "${conf_path}"
    local result=$?
    set -e
    if [[ ${result} -ne 0 ]]; then
      msg_warning "Warning: config file ${conf_file} had errors during loading"
    fi
  else
    if [[ "${conf_file}" != "default.conf" ]]; then
      msg_error "Config file not found: ${conf_path}"
      return 1
    fi
  fi
}

dry_run=0
mirror_user_flag=0

show_config() {
  msg_header "Configuration"
  echo "Config file: ${config_file-default.conf}"
  echo ""
  echo "Container Settings:"
  echo "  REPOSITORY      = ${REPOSITORY:-<not set>}"
  echo "  TAG             = ${TAG:-latest}"
  echo "  NAME            = ${NAME:-<not set>}"
  echo "  HOSTNAME        = ${HOSTNAME:-arnold}"
  echo "  SHARED_DIR      = ${SHARED_DIR:-<not set>}"
  echo "  PORTS           = ${PORTS:-<none>}"
  echo "  EXTRA_RUN_FLAGS = ${EXTRA_RUN_FLAGS:-<none>}"
  echo ""
  
  # Show network config if present
  show_network_config
  echo ""
  
  # Show mirror config if present
  show_mirror_config
}

start() {
  [[ -z "${NAME-}" ]] && die "Missing required name: --name <name>"
  echo "sudo docker start ${NAME}"
  [[ ${dry_run} -eq 0 ]] && sudo docker start ${NAME}
}

stop() {
  [[ -z "${NAME-}" ]] && die "Missing required name: --name <name>"
  echo "sudo docker stop ${NAME}"
  [[ ${dry_run} -eq 0 ]] && sudo docker stop ${NAME}
}

user() {
  [[ -z "${NAME-}" ]] && die "Missing required name: --name <name>"
  [[ -z "${USER-}" ]] && die "Missing required user: --user <user>"
  echo "sudo docker exec -u root -it ${NAME} bash -c \"su -l ${USER}\""
  [[ ${dry_run} -eq 0 ]] && sudo docker exec -u root -it ${NAME} bash -c "su -l ${USER}"
}

_shell() {
  [[ -z "${NAME-}" ]] && die "Missing required name: --name <name>"
  echo "sudo docker exec -it ${NAME} bash"
  [[ ${dry_run} -eq 0 ]] && sudo docker exec -u root -it ${NAME} bash
}

_ps() {
  echo "sudo docker ps -a"
  [[ ${dry_run} -eq 0 ]] && sudo docker ps -a
}

images() {
  echo "sudo docker images"
  [[ ${dry_run} -eq 0 ]] && sudo docker images
}

logs() {
  [[ -z "${NAME-}" ]] && die "Missing required name: --name <name>"
  echo "sudo docker logs ${NAME}"
  [[ ${dry_run} -eq 0 ]] && sudo docker logs ${NAME}
}

show() {
  images
  echo ""
  _ps
}

build() {
  [[ -z "${REPOSITORY-}" ]] && die "Missing required REPOSITORY"
  echo "sudo docker build -t ${REPOSITORY} - < ${DOCKERFILE-Dockerfile}"
  [[ ${dry_run} -eq 0 ]] && sudo docker build -t ${REPOSITORY} - < ${DOCKERFILE-Dockerfile}
}

remove() {
  [[ -z "${NAME-}" ]] && die "Missing required name: --name <name>"
  echo "sudo docker rm ${NAME}"
  [[ ${dry_run} -eq 0 ]] && sudo docker rm ${NAME}
}

remove_image() {
  [[ -z "${IMAGE-}" ]] && die "Missing required name: --image <name>"
  echo "sudo docker image rm ${IMAGE}"
  [[ ${dry_run} -eq 0 ]] && sudo docker image rm ${IMAGE}
}

sync() {
  [[ -z "${NAME-}" ]] && die "Missing required name: --name <name>"
  [[ -z "${REPOSITORY-}" ]] && die "Missing required REPOSITORY"
  echo "docker commit -m \"sync\" ${NAME} ${REPOSITORY}:${TAG-latest}"
  [[ ${dry_run} -eq 0 ]] && sudo docker commit -m "sync" ${NAME} ${REPOSITORY}:"${TAG-latest}"
}

run() {
  # Validate required parameters
  [[ -z "${NAME-}" ]] && die "Missing required name: --name <name>"
  [[ -z "${REPOSITORY-}" ]] && die "Missing required REPOSITORY"
  [[ -z "${SHARED_DIR-}" ]] && die "Missing required SHARED_DIR"
  
  # Auto-create network if configured
  if [[ ${dry_run} -eq 0 ]]; then
    auto_create_network
  fi
  
  # Build port mappings
  if [ ! -z "${PORTS}" ]; then
    PMAP="-p ${PORTS}"
  else
    PMAP=""
  fi
  
  # Build environment variables
  if [ ! -z "${ENV}" ]; then
    EMAP="-e ${ENV}"
  else
    EMAP=""
  fi
  
  # Build network flags
  NMAP=$(build_network_flags)
  
  # Build mirror mounts if user mirroring is enabled
  MMAP=""
  if [[ "${MIRROR_USER:-no}" == "yes" ]] || [[ ${mirror_user_flag} -eq 1 ]]; then
    # Detect host user if not already done
    if [[ -z "${DETECTED_USER:-}" ]]; then
      detect_host_user "${MIRROR_USER_NAME:-$USER}"
    fi
    
    # Build mirror mounts
    MMAP=$(build_mirror_mounts)
  fi
  
  EXTRA=${EXTRA_RUN_FLAGS}
  
  # Build and display command
  echo "sudo docker run -dt --privileged -v ${SHARED_DIR}:${SHARED_DIR} ${EXTRA} ${MMAP} ${PMAP} ${EMAP} ${NMAP} --name ${NAME} --hostname ${HOSTNAME-arnold} ${REPOSITORY}:${TAG-latest} /bin/bash"
  
  # Execute if not dry-run
  if [[ ${dry_run} -eq 0 ]]; then
    if sudo docker run -dt --privileged -v ${SHARED_DIR}:${SHARED_DIR} ${EXTRA} ${MMAP} \
                    ${PMAP} ${EMAP} ${NMAP} \
                    --name ${NAME} --hostname ${HOSTNAME-arnold} ${REPOSITORY}:"${TAG-latest}" /bin/bash; then
      msg_success "Container ${NAME} created and started"
      
      # Setup mirrored user if enabled
      if [[ "${MIRROR_USER:-no}" == "yes" ]] || [[ ${mirror_user_flag} -eq 1 ]]; then
        sleep 2  # Give container time to fully start
        msg_info "Setting up mirrored user..."
        setup_mirror_user "${NAME}" "${MIRROR_USER_NAME:-$DETECTED_USER}" \
                         "${MIRROR_USER_UID:-$DETECTED_UID}" \
                         "${MIRROR_USER_GID:-$DETECTED_GID}"
        setup_mirror_directories "${NAME}" "${MIRROR_USER_NAME:-$DETECTED_USER}" \
                                "${MIRROR_USER_UID:-$DETECTED_UID}" \
                                "${MIRROR_USER_GID:-$DETECTED_GID}"
      fi
    else
      msg_error "Failed to create container"
      return 1
    fi
  fi
}

_exec() {
  [[ -z "${NAME-}" ]] && die "Missing required name: --name <name>"
  [[ -z "${xcmd-}" ]] && die "Missing required cmd: --cmd <cmd>"
  echo "sudo docker exec -u root -it ${NAME} ${xcmd}"
  [[ ${dry_run} -eq 0 ]] && sudo docker exec -u root -it ${NAME} ${xcmd}
}

_root_exec() {
  [[ -z "${NAME-}" ]] && die "Missing required name: --name <name>"
  echo "sudo docker exec -u root ${NAME} bash -c \"$1\""
  [[ ${dry_run} -eq 0 ]] && sudo docker exec -u root ${NAME} bash -c "$1"
  return 0
}

setup_users() {
  [[ -z "${USERS-}" ]] && die "Missing required USERS csv file: --users <file>"
  [[ ${dry_run} -eq 1 ]] && printf '%-20.20s %-10.10s %-20.20s %-10.10s\n' "USERNAME" "USERID" "GROUPNAME" "GROUPID"
  while IFS="," read -r username userid groupname groupid
    do
      [[ ${dry_run} -eq 1 ]] && printf '%s\n %-20.20s %-10.10s %-20.20s %-10.10s\n' "---" ${username} ${userid} ${groupname} ${groupid}
      _root_exec "groupadd -f -g ${groupid} ${groupname}"
      _root_exec "useradd -m -u ${userid} -g ${groupid} ${username} -s /bin/bash"
      _root_exec "echo '${username}  ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/${username}"
    done < ${USERS}
}

setup_mirror() {
  [[ -z "${NAME-}" ]] && die "Missing required name: --name <name>"
  
  # Detect host user
  detect_host_user "${MIRROR_USER_NAME:-$USER}"
  
  # Setup user in container
  setup_mirror_user "${NAME}" "${MIRROR_USER_NAME:-$DETECTED_USER}" \
                   "${MIRROR_USER_UID:-$DETECTED_UID}" \
                   "${MIRROR_USER_GID:-$DETECTED_GID}"
  
  # Setup directories
  setup_mirror_directories "${NAME}" "${MIRROR_USER_NAME:-$DETECTED_USER}" \
                          "${MIRROR_USER_UID:-$DETECTED_UID}" \
                          "${MIRROR_USER_GID:-$DETECTED_GID}"
}

# Network command dispatcher
network_cmd() {
  local subcmd="${1:-}"
  shift || true
  
  case "${subcmd}" in
    create)
      network_create
      ;;
    list|ls)
      network_list
      ;;
    inspect)
      network_inspect "$@"
      ;;
    remove|rm)
      network_remove "$@"
      ;;
    connect)
      network_connect "$@"
      ;;
    disconnect)
      network_disconnect "$@"
      ;;
    *)
      echo "Usage: $(basename "${BASH_SOURCE[0]}") network <create|list|inspect|remove|connect|disconnect> [args]"
      echo ""
      echo "Network commands:"
      echo "  create                    Create network from config file"
      echo "  list, ls                  List all networks"
      echo "  inspect <network>         Inspect network details"
      echo "  remove <network>          Remove a network"
      echo "  connect <net> <container> Connect container to network"
      echo "  disconnect <net> <cont>   Disconnect container from network"
      exit 1
      ;;
  esac
}

msg() {
  echo >&2 -e "${1-}"
}

die() {
  local msg=$1
  local code=${2-1}
  msg_error "$msg"
  exit "$code"
}

parse_params() {
  # If no arguments provided, default to interactive mode
  if [[ $# -eq 0 ]]; then
    cmd="interactive"
    return 0
  fi
  
  # Handle help flags before treating first arg as command
  if [[ "${1}" == "-h" ]] || [[ "${1}" == "--help" ]]; then
    usage
  fi
  
  cmd="${1:-}"; shift || true

  while :; do
    case "${1-}" in
    -h | --help) usage ;;
    -v | --verbose) 
      set -x 
      VERBOSE=1
      ;;
    -n | --name)
      NAME="${2-}"
      shift
      ;;
    --tag)
      TAG="${2-}"
      shift
      ;;
    --image)
      IMAGE="${2-}"
      shift
      ;;
    -u | --user)
      USER="${2-}"
      shift
      ;;
    -p | --ports)
      PORTS="${2-}"
      shift
      ;;
    -e | --env)
      ENV="${2-}"
      shift
      ;;
    --xcmd)
      xcmd="${2-}"
      shift
      ;;
    --config)
      config_file="${2-}"
      config
      shift
      ;;
    --users)
      USERS="${2-}"
      shift
      ;;
    --docker-file)
      DOCKERFILE="${2-}"
      shift
      ;;
    --network)
      NETWORK_NAME="${2-}"
      shift
      ;;
    --mirror-user)
      mirror_user_flag=1
      ;;
    --dry-run) 
      dry_run=1 
      ;;
    -?*) die "Unknown option: $1" ;;
    *) break ;;
    esac
    shift
  done

  args=("$@")

  [[ -z "${cmd-}" ]] && die "Missing required command: <cmd>"

  return 0
}

# Load default config
config

# Parse parameters
parse_params "$@"

# Execute command
case "${cmd-}" in
  help) usage ;;
  build) build ;;
  exec) _exec ;;
  user) user ;;
  shell) _shell ;;
  sync) sync ;;
  start) start ;;
  stop) stop ;;
  show) show ;;
  run) run ;;
  rm) remove ;;
  rm_image) remove_image ;;
  ps) _ps ;;
  images) images ;;
  logs) logs ;;
  show_config) show_config ;;
  setup_users) setup_users ;;
  setup_mirror) setup_mirror ;;
  network) network_cmd "${args[@]}" ;;
  wizard) config_wizard ;;
  quick) quick_wizard ;;
  interactive) interactive_shell ;;
  *) die "Unknown command: ${cmd}" ;;
esac
